# ────────────────────────────────────────────────
# Workflow Orchestrator — Environment Variables
# ────────────────────────────────────────────────

# MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/workflow-orchestrator

# Server
PORT=8000
CORS_ORIGIN=*

# JWT Tokens
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d

# Email — Brevo (Sendinblue) Transactional API
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Workflow Orchestrator

# Frontend & Server URLs
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:8000

# GitHub Issues Sync
GITHUB_TOKEN=your_github_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Groq + RAG Configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
MAX_FILE_SIZE_MB=50
RAG_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_SECTION_TOKENS=220
RAG_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RAG_EMBEDDING_DEVICE=cpu
RAG_INDEX_PATH=rag-index/synopsis
RAG_SERVICE_URL=http://127.0.0.1:5001/rag
