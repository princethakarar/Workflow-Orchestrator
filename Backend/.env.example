# ────────────────────────────────────────────────
# Workflow Orchestrator — Environment Variables
# ────────────────────────────────────────────────

# MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/workflow-orchestrator

# Server
PORT=8000
CORS_ORIGIN=*

# JWT Tokens
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d

# Email — Brevo (Sendinblue) Transactional API
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Workflow Orchestrator

# Frontend & Server URLs
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:8000

# GitHub Issues Sync
GITHUB_TOKEN=your_github_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repo_name
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ────────────────────────────────────────────────
# Groq + RAG Configuration
# ────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# Read by aiController.js. Leave unset to use the default below.
GROQ_MODEL=llama-3.3-70b-versatile

# Base URL of the Python RAG microservice. Either form works — "…/rag" is
# appended or stripped as needed by src/config/ragConfig.js.
RAG_SERVICE_URL=http://127.0.0.1:5001/rag

# Shared secret gating every route on the RAG service (header: X-RAG-Secret).
# ROLLOUT ORDER: set this on the Node backend FIRST, then on the RAG service.
# The RAG service stays open (and warns on every start) until it has the value,
# so configuring the two services in this order avoids an outage window.
RAG_SHARED_SECRET=

# Optional. Comma-separated browser origins allowed to call the RAG service
# directly. Leave empty — the React app talks to this backend, never to the RAG
# service, so no browser needs cross-origin access to it.
RAG_ALLOWED_ORIGINS=

# ── Documentation only — NOT read by any code ──────────────────────────────
# These record the values actually in force so nobody has to read the source to
# find them. Editing them changes nothing. The real definitions live at:
#   rag_service/app.py:63-66   TOP_K / MIN_CHUNK_CHARS / MAX_CHUNK_CHARS / OVERLAP_WORDS
#   rag_service/app.py:38      embedding model + device
#   src/routes/aiRoutes.js:23  upload size limit
# Wiring them for real would change retrieval or chunking output, so it is
# deferred to the re-index wave rather than done as a cleanup.
RAG_TOP_K=10                    # app.py TOP_K (was documented as 3 — never true)
RAG_CHUNK_SIZE=1800             # app.py MAX_CHUNK_CHARS (was documented as 500)
RAG_MIN_CHUNK_CHARS=300         # app.py MIN_CHUNK_CHARS — below this, blocks are DISCARDED
RAG_OVERLAP_WORDS=40            # app.py OVERLAP_WORDS (overlap is in words, not chars)
RAG_EMBEDDING_MODEL_ACTUAL=all-MiniLM-L6-v2   # loaded locally via sentence-transformers
RAG_EMBEDDING_DEVICE=cpu        # hardcoded; CUDA is disabled before torch imports
MAX_FILE_SIZE_MB=10             # multer limit in aiRoutes.js (was documented as 50)

# ────────────────────────────────────────────────
# Keep-Alive Configuration
# Both Render services must be pinged every 14 min via cron-job.org
# Express health: https://workflow-orchestrator-backend.onrender.com/health
# RAG health:     https://rag-service-uepk.onrender.com/health
# ────────────────────────────────────────────────
